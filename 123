    assert(not name:find('[%c/\\:*?"<>|]') and not name:find("..", 1, true) and not name:match("[%. ]$"), "Invalid configuration name")
    local upper = name:upper()
    assert(not ({CON = true, PRN = true, AUX = true, NUL = true})[upper] and not upper:match("^COM%d$") and not upper:match("^LPT%d$"), "Reserved configuration name")
    return name
end
function Library:CreateConfigStore(window, options)
    options = options or {}
    local id = tostring(game.GameId or game.PlaceId or 0)
    local title = options.GameName
    if not title then
        pcall(function() title = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name end)
    end
    title = tostring(title or "Game"):gsub('[%c/\\:*?"<>|]', "_"):gsub("%.%.", "_"):sub(1, 64):gsub("[%. ]+$", "")
    if title == "" then title = "Game" end
    local store = {Window = window, Directory = "Stereo/" .. title .. "_" .. id, Names = {}, Settings = {Enabled = false, Autoload = false}, Selected = nil}
    store.IndexPath = store.Directory .. "/_index.json"
    local function exists(path)
        if type(isfile) == "function" then local ok, result = pcall(isfile, path) return ok and result == true end
        if type(readfile) == "function" then return pcall(readfile, path) end
        return false
    end
    function store:_write(path, data)
        assert(type(writefile) == "function", "Executor has no writefile")
        local previous = exists(path) and readfile(path) or nil
        local ok, message = pcall(function()
            writefile(path, data)
            if type(readfile) == "function" then assert(readfile(path) == data, "File verification failed") end
        end)
        if not ok then
            if previous then pcall(writefile, path, previous) elseif type(delfile) == "function" then pcall(delfile, path) end
            error(message)
        end
    end
    function store:_index()
        self:_write(self.IndexPath, HttpService:JSONEncode({Version = 1, Names = self.Names, Enabled = self.Settings.Enabled, Autoload = self.Settings.Autoload}))
    end
    function store:_path(name) return self.Directory .. "/" .. safeConfigName(name) .. ".json" end
    function store:_ready()
        assert(type(readfile) == "function" and type(writefile) == "function", "Executor filesystem API unavailable")
        ensureFolder(self.Directory)
    end
    function store:Refresh()
        local ok, message = pcall(function()
            self:_ready()
            local candidates = copy(self.Names)
            if exists(self.IndexPath) then
                local decoded = HttpService:JSONDecode(readfile(self.IndexPath))
                assert(type(decoded) == "table", "Invalid profile index")
                for _, name in ipairs(decoded.Names or {}) do candidates[#candidates + 1] = name end
                self.Settings.Enabled = decoded.Enabled == true
                self.Settings.Autoload = type(decoded.Autoload) == "string" and decoded.Autoload or false
            end
            if type(listfiles) == "function" then
                for _, path in ipairs(listfiles(self.Directory)) do
                    local name = tostring(path):gsub("\\", "/"):match("/([^/]+)%.json$")
                    if name and name ~= "_index" then candidates[#candidates + 1] = name end
                end
            end
            local names = {}
            for _, name in ipairs(candidates) do
                local valid, clean = pcall(safeConfigName, name)
                if valid and clean ~= "_index" and exists(self:_path(clean)) and not table.find(names, clean) then names[#names + 1] = clean end
            end
            table.sort(names, function(a, b) return a:lower() < b:lower() end)
            self.Names = names
            if self.Selected and not table.find(names, self.Selected) then self.Selected = nil end
            if not self.Selected then self.Selected = names[1] end
            self.Ready = true
            call(self.OnChanged, self)
        end)
        self.Ready = ok
        self.Error = not ok and tostring(message) or nil
        return ok, self.Error
    end
    function store:Save(name, createOnly)
        local ok, result = pcall(function()
            self:_ready() name = safeConfigName(name)
            assert(name:lower() ~= "_index", "Reserved configuration name")
            for _, existing in ipairs(self.Names) do assert(existing:lower() ~= name:lower() or existing == name, "Configuration name differs only in letter case") end
            local path = self:_path(name)
            assert(not createOnly or not exists(path), "Configuration already exists")
            local previous = exists(path) and readfile(path) or nil
            local data = window:GetConfig()
            HttpService:JSONDecode(data)
            if previous then self:_write(path .. ".bak", previous) end
            local written, message = pcall(self._write, self, path, data)
            if not written then
                if previous then pcall(writefile, path, previous) end
                error(message)
            end
            local oldNames, oldSelected = copy(self.Names), self.Selected
            if not table.find(self.Names, name) then self.Names[#self.Names + 1] = name end
            self.Selected = name
            local indexed, indexError = pcall(self._index, self)
            if not indexed then
                self.Names, self.Selected = oldNames, oldSelected
                if previous then pcall(writefile, path, previous) elseif type(delfile) == "function" then pcall(delfile, path) end
                error(indexError)
            end
            self:Refresh()
            return path
        end)
        self.Error = not ok and tostring(result) or nil
        return ok, result
    end
    function store:Create(name) return self:Save(name, true) end
    function store:Load(name, silent)
        local ok, result = pcall(function()
            self:_ready() name = safeConfigName(name)
            assert(exists(self:_path(name)), "Configuration does not exist")
            local loaded, message = window:LoadConfig(readfile(self:_path(name)), silent)
            assert(loaded, message)
            self.Selected = name call(self.OnChanged, self)
            return name
        end)
        return ok, result
    end
    function store:Delete(name)
        local ok, result = pcall(function()
            self:_ready() name = safeConfigName(name)
            assert(type(delfile) == "function", "Executor has no delfile")
            local path = self:_path(name) assert(exists(path), "Configuration does not exist")
            local previous = readfile(path)
            local oldNames, oldSelected, oldSettings = copy(self.Names), self.Selected, copy(self.Settings)
            delfile(path)
            for i = #self.Names, 1, -1 do if self.Names[i] == name then table.remove(self.Names, i) end end
            if self.Settings.Autoload == name then self.Settings.Autoload = false self.Settings.Enabled = false end
            if self.Selected == name then self.Selected = nil end
            local indexed, message = pcall(self._index, self)
            if not indexed then
                pcall(writefile, path, previous)
                self.Names, self.Selected, self.Settings = oldNames, oldSelected, oldSettings
                error(message)
            end
            if exists(path .. ".bak") then pcall(delfile, path .. ".bak") end
            self:Refresh()
            return name
        end)
        return ok, result
    end
    function store:SetAutoload(name, enabled)
        local ok, result = pcall(function()
            self:_ready()
            local previous = copy(self.Settings)
            if enabled then
                name = safeConfigName(name)
                assert(exists(self:_path(name)), "Save the configuration before enabling autoload")
                self.Settings.Autoload = name self.Settings.Enabled = true
            else self.Settings.Enabled = false end
            local indexed, message = pcall(self._index, self)
            if not indexed then self.Settings = previous error(message) end
            call(self.OnChanged, self)
            return self.Settings.Enabled
        end)
        return ok, result
    end
    function store:Autoload()
        if not self.Settings.Enabled or not self.Settings.Autoload then return true, "Disabled" end
        return self:Load(self.Settings.Autoload)
    end
    function store:Select(name)
        if not table.find(self.Names, name) then return false, "Configuration does not exist" end
        self.Selected = name return true
    end
    store:Refresh()
    window.ConfigStore = store
    return store
end
function Window:ConfigTab(options)
    options = options or {}
    local store = Library:CreateConfigStore(self, options)
    local tab = self:Tab({Name = options.Name or "Config", Width = 98})
    local page = tab:Section({Name = "Config", Hidden = true})
    local group = page:Group("Configurations")
    local status = group:Label({Text = store.Directory, TextSize = 18})
    local selected = group:Combo({Name = "Selected Config", Items = #store.Names > 0 and store.Names or {"No configurations"}, Default = store.Selected or "No configurations", Persist = false})
    local name = group:Input({Name = "Config Name", Placeholder = "Enter a name...", Default = "", Persist = false, MaxLength = 64})
    local autoload = group:Checkbox({Name = "Autoload Selected Config", Default = store.Settings.Enabled, Persist = false})
    local refreshing = false
    local function refresh()
        if refreshing or self.Dead then return end refreshing = true
        selected:SetItems(#store.Names > 0 and store.Names or {"No configurations"}, store.Selected or "No configurations")
        autoload:Set(store.Settings.Enabled, true)
        status:Set(store.Error or store.Directory)
        refreshing = false
    end
    store.OnChanged = refresh
    selected.Callback = function(value)
        if not refreshing then
            store:Select(value)
            if store.Settings.Enabled then
                local ok, message = store:SetAutoload(value, true)
                if not ok then self:Notify({Title = "Autoload", Text = tostring(message), Icon = "triangle-alert"}) end
            end
        end
    end
    local function report(ok, message)
        refresh()
        self:Notify({Title = "Configuration", Text = ok and "Operation completed." or tostring(message), Icon = ok and "check" or "triangle-alert", Color = ok and AccentColors.Green or AccentColors.Red})
        return ok, message
    end
    autoload.Callback = function(enabled) report(store:SetAutoload(store.Selected, enabled)) end
    local function configName() local typed = name:Get():match("^%s*(.-)%s*$") return typed ~= "" and typed or store.Selected end
    local actions = {}
    actions.Create = function() return report(store:Create(name:Get())) end
    actions.Save = function() return report(store:Save(configName())) end
    actions.Load = function() return report(store:Load(store.Selected)) end
    actions.Delete = function()
        if not store.Selected then return report(false, "Select a configuration") end
        local target = store.Selected
        return self:Dialog({Title = "Delete Configuration", Text = "Delete \"" .. target .. "\"?", Buttons = {
            {Text = "Yes", HoverGradient = "Red", Callback = function() report(store:Delete(target)) end},
            {Text = "No", HoverGradient = "Green"}
        }})
    end
    actions.Refresh = function() return report(store:Refresh()) end
    page:Space(12)
    page:ButtonBar({{Name = "CREATE", Callback = actions.Create}, {Name = "SAVE", Callback = actions.Save}, {Name = "LOAD", Callback = actions.Load}, {Name = "DELETE", Callback = actions.Delete}, {Name = "REFRESH", Callback = actions.Refresh}})
    page:Space(16)
    local details = page:Group("Storage")
    details:Label({Text = "Profiles are stored per game in the Stereo folder.", TextSize = 20})
    details:Label({Text = "No demo profiles are created. Autoload is optional.", TextSize = 20})
    tab.Store, tab.Page, tab.Actions, tab.NameInput, tab.SelectedConfig, tab.Autoload = store, page, actions, name, selected, autoload
    refresh()
    return tab, store
end

