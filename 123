        local ok = pcall(makefolder, "LibraryFonts")
        if ok or (type(isfolder) == "function" and isfolder("LibraryFonts")) then prefix = "LibraryFonts/" end
    end
    for name, data in pairs(EmbeddedFonts) do
        local ok, message = pcall(function()
