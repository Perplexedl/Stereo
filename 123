local function ensureFolder(path)
    local current = ""
    for segment in path:gmatch("[^/]+") do
        current = current == "" and segment or current .. "/" .. segment
        local exists = false
        if type(isfolder) == "function" then local ok, result = pcall(isfolder, current) exists = ok and result end
        if not exists then
            assert(type(makefolder) == "function", "Executor has no makefolder")
            local ok, message = pcall(makefolder, current)
            if not ok then assert(type(isfolder) == "function" and isfolder(current), tostring(message)) end
        end
    end
end
local function fetchBytes(url)
    assert(type(url) == "string" and url:match("^https://"), "HTTPS URL required")
    local requestFunction = request or http_request or (syn and syn.request)
    if type(requestFunction) == "function" then
        local response = requestFunction({Url = url, Method = "GET"})
        assert(response and (response.StatusCode == 200 or response.Success == true), "HTTP request failed")
        return assert(response.Body, "Empty HTTP body")
    end
    return game:HttpGet(url)
end
function Library:CacheImage(url, name, fallback)
    local asset = getcustomasset or getsynasset
    if type(asset) ~= "function" or type(writefile) ~= "function" then return nil, "Local image API unavailable" end
    local path = "Stereo/assets/" .. tostring(name):gsub("[^%w_-]", "_") .. ".png"
    local ok, result = pcall(function()
        ensureFolder("Stereo/assets")
        if type(isfile) == "function" and isfile(path) then return asset(path) end
        local downloaded, data = pcall(fetchBytes, url)
        if not downloaded or type(data) ~= "string" or not (data:sub(1, 8) == "\137PNG\r\n\26\n" or data:sub(1, 3) == "\255\216\255") then
            assert(fallback, "Image download failed or invalid format") data = decode64(fallback)
        end
        assert(#data < 10 * 1024 * 1024, "Image is too large")
        writefile(path, data)
        return asset(path)
    end)
    return ok and result or nil, not ok and tostring(result) or nil
end
