local function decode64(data)
    data = data:gsub("%s", "")
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i = 1, #alphabet do map[string.byte(alphabet, i)] = i - 1 end
    local output = {}
    for i = 1, #data, 4 do
        local a, b, c, d = string.byte(data, i, i + 3)
        local n = (map[a] or 0) * 262144 + (map[b] or 0) * 4096 + (map[c] or 0) * 64 + (map[d] or 0)
        output[#output + 1] = string.char(math.floor(n / 65536) % 256)
        if c and c ~= 61 then output[#output + 1] = string.char(math.floor(n / 256) % 256) end
        if d and d ~= 61 then output[#output + 1] = string.char(n % 256) end
    end
    return table.concat(output)
end
local function installFonts()
