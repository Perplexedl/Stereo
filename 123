            if widget.LastWidth ~= width then widget.LastWidth = width widget:_render() end
        end
    end)
    window.NestedScrolls = window.NestedScrolls or {}
    window.NestedScrolls[#window.NestedScrolls + 1] = scroll
    widget:SetVersions(options.Versions or options.Entries or {})
