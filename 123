    if options.Filled ~= false then stroke(hit, 0.84) end
    local bg = fade(hit) hover(window, hit, bg)
    local chosen = label(hit, "", 17, "Bold", UDim2.fromOffset(12, 0), UDim2.new(1, -45, 1, 0))
    chosen.TextColor3 = White chosen.TextTruncate = Enum.TextTruncate.AtEnd
