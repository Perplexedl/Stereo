function Group:RangeSlider(options)
    options = options or {}
    local window = self.Window
    local row, text, value = self:_row(options.Name or "Range")
    local minimum, maximum = tonumber(options.Min) or 0, tonumber(options.Max) or 100
    assert(maximum > minimum, "Invalid range slider limits")
    local step = tonumber(options.Step) or (options.Integer and 1 or 0.01)
    assert(step > 0 and step < math.huge, "Invalid range slider step")
    local gap = math.clamp(tonumber(options.MinGap) or 0, 0, maximum - minimum)
    local function snap(v, fallback)
        v = tonumber(v)
        if not v or v ~= v or math.abs(v) == math.huge then v = fallback end
        return math.clamp(minimum + math.floor((v - minimum) / step + 0.5) * step, minimum, maximum)
    end
    local control = setmetatable({Row = row, Label = text, Page = self.Page, Value = {}}, Control)
    control.Normalize = function(v)
        assert(type(v) == "table", "Range value must be a table")
        local lo = snap(v.Min or v.min or v[1], minimum)
        local hi = snap(v.Max or v.max or v[2], maximum)
        if lo > hi then lo, hi = hi, lo end
        if hi - lo < gap then hi = math.min(maximum, lo + gap) lo = math.max(minimum, hi - gap) end
        return {Min = lo, Max = hi}
    end
    control.Value = control.Normalize(options.Default or {Min = minimum, Max = maximum})
    local hit = button(value, UDim2.fromOffset(0, 0), UDim2.new(1, -168, 1, 0))
    hit.Name = "RangeInput"
    local rail = frame(hit, "Rail", UDim2.new(0, 8, 0.5, -3), UDim2.new(1, -16, 0, 6), Color3.fromRGB(201, 207, 214), 0.76)
    corner(rail, 3)
    local fill = frame(rail, "RangeFill", nil, UDim2.fromScale(1, 1), White, 0.35)
    corner(fill, 3)
    local low = frame(rail, "MinGrab", UDim2.fromScale(0, 0.5), UDim2.fromOffset(12, 12), White, 0.04)
    local high = frame(rail, "MaxGrab", UDim2.fromScale(1, 0.5), UDim2.fromOffset(12, 12), White, 0.04)
    low.AnchorPoint = Vector2.new(0.5, 0.5) high.AnchorPoint = Vector2.new(0.5, 0.5)
    corner(low, 3) corner(high, 3)
    local function numeric(name, offset)
        local box = new("TextBox", {Name = name, Position = UDim2.new(1, offset, 0, 1), Size = UDim2.fromOffset(76, 38),
            BackgroundColor3 = Dark, BackgroundTransparency = 0.82, BorderSizePixel = 0, Text = "",
            TextColor3 = White, TextSize = 17, FontFace = Fonts.Bold, ClearTextOnFocus = false}, value)
        corner(box, 3) stroke(box, 0.84)
        return box
    end
    local minBox, maxBox = numeric("Minimum", -160), numeric("Maximum", -76)
    local format = options.Format or (options.Integer and "%.0f" or "%.1f")
    local function display(v)
        local ok, result = pcall(string.format, format:gsub("%%d", "%%.0f"), v)
        return ok and result or tostring(v)
    end
    local active, painted
    control.Paint = function()
        local lo = (control.Value.Min - minimum) / (maximum - minimum)
        local hi = (control.Value.Max - minimum) / (maximum - minimum)
        local function move(object, properties)
            if active or not painted then
                for key, val in pairs(properties) do stopAnimation(object, key) object[key] = val end
            else tween(object, properties, 0.16, "Cubic") end
        end
        move(low, {Position = UDim2.fromScale(lo, 0.5)})
        move(high, {Position = UDim2.fromScale(hi, 0.5)})
        move(fill, {Position = UDim2.fromScale(lo, 0), Size = UDim2.fromScale(hi - lo, 1)})
        if not minBox:IsFocused() then minBox.Text = display(control.Value.Min) end
        if not maxBox:IsFocused() then maxBox.Text = display(control.Value.Max) end
        painted = true
    end
    window:_register(control, options)
    control.Paint()
    local lastHandle = "Max"
    beginPointer(window, hit, function(point)
        if control.Disabled then return end
        local fraction = math.clamp((point.X - rail.AbsolutePosition.X) / math.max(1, rail.AbsoluteSize.X), 0, 1)
        local v = snap(minimum + fraction * (maximum - minimum), minimum)
        if not active then
            local a, b = math.abs(v - control.Value.Min), math.abs(v - control.Value.Max)
            active = a == b and (lastHandle == "Min" and "Max" or "Min") or (a < b and "Min" or "Max")
            lastHandle = active
            tween(active == "Min" and low or high, {Size = UDim2.fromOffset(15, 15)}, 0.1, "Cubic")
        end
        local current = control:Get()
        if active == "Min" then current.Min = math.min(v, current.Max - gap)
        else current.Max = math.max(v, current.Min + gap) end
        control:Set(current, false, "input")
    end, function()
        active = nil
        tween(low, {Size = UDim2.fromOffset(12, 12)}, 0.15, "Cubic")
        tween(high, {Size = UDim2.fromOffset(12, 12)}, 0.15, "Cubic")
    end)
    for key, box in pairs({Min = minBox, Max = maxBox}) do
        window:_connect(box.Focused, function() box.Text = tostring(control.Value[key]) tween(box, {BackgroundTransparency = 0.62}) end)
        window:_connect(box.FocusLost, function()
            local n = tonumber(box.Text) or tonumber(box.Text:match("[+-]?%d*%.?%d+"))
            if n then
                local current = control:Get()
                if key == "Min" then current.Min = math.min(snap(n, minimum), current.Max - gap)
                else current.Max = math.max(snap(n, maximum), current.Min + gap) end
                control:Set(current, false, "input")
            end
            box.Text = display(control.Value[key]) tween(box, {BackgroundTransparency = 0.82})
        end)
    end
    window:_connect(hit.MouseEnter, function() tween(rail, {BackgroundTransparency = 0.58}) end)
    window:_connect(hit.MouseLeave, function() tween(rail, {BackgroundTransparency = 0.76}) end)
    function control:SetRange(lo, hi, silent) return self:Set({Min = lo, Max = hi}, silent) end
    function control:GetRange() return self.Value.Min, self.Value.Max end
    control.MinInput, control.MaxInput, control.Hit = minBox, maxBox, hit
    return control
end
