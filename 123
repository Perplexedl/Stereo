function Library:Destroy()
    self:DisableDexGuard()
    if NotificationManager then NotificationManager:Destroy() end
    local windows = table.clone(self.Windows)
    for _, window in ipairs(windows) do window:Destroy() end
    local sessions = {}
    for session in pairs(BlurSessions) do sessions[#sessions + 1] = session end
    for _, session in ipairs(sessions) do session:Destroy() end
    table.clear(Animations)
    if AnimationConnection then AnimationConnection:Disconnect() AnimationConnection = nil end
end

