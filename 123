        DisplayOrder = Library.NotificationSettings.DisplayOrder, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, CoreGui)
    pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None gui.ClipToDeviceSafeArea = false end)
    local manager = {Gui = gui, Items = {}, Pending = {}, Connections = {}}
    NotificationManager = manager
    function manager:Layout()
        if self.Dead then return end
        local settings = Library.NotificationSettings
        self.Gui.DisplayOrder = settings.DisplayOrder
        local camera = Workspace.CurrentCamera
        local view = camera and camera.ViewportSize or gui.AbsoluteSize
        local widest, tallest = settings.Width, 1
        for _, item in ipairs(self.Items) do
            if not item.Dead and not item.Closing then widest = math.max(widest, item.Width) tallest = math.max(tallest, item.Height) end
        end
        local fit = math.min(math.max(1, view.X - settings.Margin * 2) / widest, math.max(1, view.Y - settings.Margin * 2) / tallest)
        self.ScaleSignature = 0
