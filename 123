function Window:SetTitle(text)
    self.TitleLabel.Text = tostring(text)
    return self
end
function Window:SetDraggable(enabled)
    self.DragHandle.Interactable = not not enabled
    if not enabled and self.Pointer and self.Pointer.Target == self.DragHandle then
        call(self.Pointer.Finish, true) self.Pointer = nil
    end
    return self
end
function Window:SetResizable(enabled)
    self.Resizable = not not enabled
    if self.ResizeGrip then stopAnimation(self.ResizeGrip) self.ResizeGrip.ImageTransparency = 1 end
    for _, handle in ipairs(self.ResizeHandles) do handle.Visible = not not enabled end
    if not enabled and self.Pointer and self.Pointer.Target.Name:sub(1, 6) == "Resize" then
        call(self.Pointer.Finish, true) self.Pointer = nil
    end
    return self
end
function Window:SetBlurMode(mode)
    if self.BlurObject then self.BlurObject:SetMode(mode) end
    return self
end
function Window:SetBlurPadding(value)
    if self.BlurObject then self.BlurObject:SetPadding(value) end
    return self
end
function Window:SetBlurIntensity(value)
    if self.BlurObject then self.BlurObject:SetIntensity(value) end
    return self
end
function Library:SetReducedMotion(enabled)
    self.ReducedMotion = not not enabled
    return self
end
