function Group:MultiDropdown(options)
    options = options or {}
    local window = self.Window
    local row, text, value = self:_row(options.Name or "Multi Dropdown")
    local items = copy(options.Items or {})
    assert(#items > 0, "MultiDropdown requires items")
    local function validateItems(values)
        local seen = {}
        for _, item in ipairs(values) do
            assert(type(item) == "string" or type(item) == "number", "MultiDropdown items must be strings or numbers")
            assert(item == item and not seen[item], "MultiDropdown items must be unique")
            seen[item] = true
        end
    end
    validateItems(items)
    local control = setmetatable({Row = row, Label = text, Page = self.Page, Items = items, Value = {}, OptionPainters = {}}, Control)
    local limit = math.max(0, math.floor(tonumber(options.MaxSelected) or #items))
    control.Normalize = function(values)
        assert(type(values) == "table", "MultiDropdown value must be a table")
        local wanted, result = {}, {}
        for key, item in pairs(values) do
            if type(key) == "number" and type(item) ~= "boolean" then wanted[item] = true
            elseif item == true then wanted[key] = true end
        end
        for _, item in ipairs(control.Items) do
            if wanted[item] and not table.find(result, item) and #result < limit then result[#result + 1] = item end
        end
        return result
    end
    control.Value = control.Normalize(options.Default or {})
    local hit = button(value, UDim2.new(1, 0, 0, 1), UDim2.new(1, 0, 0, 38))
    hit.Name = "MultiDropdown" hit.AnchorPoint = Vector2.new(1, 0)
    hit.BackgroundColor3 = Dark hit.BackgroundTransparency = options.Filled == false and 1 or 0.76
