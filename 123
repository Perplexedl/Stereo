local function equal(a, b)
    if type(a) ~= type(b) then return false end
    if type(a) ~= "table" then return a == b end
    for key, value in pairs(a) do if not equal(value, b[key]) then return false end end
    for key in pairs(b) do if a[key] == nil then return false end end
    return true
end
function Window:On(event, callback)
    assert(type(callback) == "function", "Event callback must be a function")
    self.Events[event] = self.Events[event] or {}
    local connection = {Connected = true, Callback = callback}
    function connection:Disconnect() self.Connected = false end
    table.insert(self.Events[event], connection)
    return connection
end
Window.Hook = Window.On
function Window:_emit(event, ...)
    local listeners = self.Events[event]
    if not listeners then return true end
    for _, listener in ipairs(table.clone(listeners)) do
        if listener.Connected then
            local ok, result = pcall(listener.Callback, ...)
            if not ok then warn("Library " .. event .. ": " .. tostring(result))
            elseif result == false and event:sub(1, 6) == "Before" then return false end
        end
    end
    return true
end
function Window:_notifyChange(control, old, silent, source)
    if silent or equal(old, control.Value) then return end
    local context = {Flag = control.Flag, Value = copy(control.Value), Previous = copy(old), Control = control, Source = source or "api"}
    if self.BatchDepth > 0 then
        local previous = self.PendingChanges[control]
        if previous then context.Previous = previous.Previous end
        self.PendingChanges[control] = context
        return
    end
    call(control.Callback, copy(context.Value), control)
    for _, listener in ipairs(control.Listeners) do
        if listener.Connected then call(listener.Callback, copy(context.Value), control) end
    end
    self:_emit("Changed", context)
    if self.AutoSave and not self.LoadingConfig then self:_scheduleSave() end
end
function Window:Batch(callback)
    self.BatchDepth = self.BatchDepth + 1
    local ok, result = pcall(callback)
    self.BatchDepth = self.BatchDepth - 1
    if self.BatchDepth == 0 then
        local pending = self.PendingChanges
        self.PendingChanges = {}
        for control, change in pairs(pending) do self:_notifyChange(control, change.Previous, false, change.Source) end
    end
    if not ok then self:_emit("Error", tostring(result)) end
    return ok, result
end
function Window:_register(control, options)
    local flag = options.Flag
    assert(not flag or type(flag) == "string", "Flag must be a string")
    assert(not flag or not self.Controls[flag], "Duplicate flag: " .. tostring(flag))
    control.Flag, control.Callback, control.Window = flag, options.Callback, self
    control.Persist = options.Persist ~= false
    control.Listeners = {}
    control.Default = copy(control.Value)
    control.Validator = options.Validate
    self.AllControls[#self.AllControls + 1] = control
    if flag then self.Controls[flag] = control self.Flags[flag] = copy(control.Value) end
    if control.Row then
        self:_connect(control.Row.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then self:Focus() end
        end)
    end
    if options.Tooltip and control.Row then self:_attachTooltip(control.Row, tostring(options.Tooltip)) end
    self:_emit("ControlAdded", control)
    return control
end
function Control:_prepare(value, source, strict)
    if strict then
        local expected, actual = type(self.Default), type(value)
        if expected ~= actual and not (expected == "table" and typeof(value) == "Color3") then return false, "Invalid value type for " .. tostring(self.Flag) end
    end
    local ok, normalized = pcall(function() if self.Normalize then return self.Normalize(value) end return value end)
    if not ok then return false, tostring(normalized) end
    if type(normalized) == "number" and (normalized ~= normalized or math.abs(normalized) == math.huge) then return false, "Non-finite number" end
    local context = {Flag = self.Flag, Value = copy(normalized), Previous = self:Get(), Control = self, Source = source or "api"}
    if not self.Window:_emit("BeforeChange", context) then return false, "Change cancelled" end
    if self.Normalize then
        local success, result = pcall(self.Normalize, context.Value)
        if not success then return false, tostring(result) end
        normalized = result
    else normalized = context.Value end
    if self.Validator then
        local success, valid, message = pcall(self.Validator, normalized, self)
        if not success then return false, tostring(valid) end
        if valid == false then return false, message or "Validation failed" end
    end
    return true, normalized
end
function Control:_apply(value, silent, source)
    local old = self:Get()
    self.LastSource = source or "api"
    self.Value = copy(value)
    if self.Flag then self.Window.Flags[self.Flag] = copy(value) end
    if self.Paint then
        local ok, errorMessage = pcall(self.Paint)
        if not ok then
            self.Value = old
            if self.Flag then self.Window.Flags[self.Flag] = copy(old) end
            pcall(self.Paint)
            return false, tostring(errorMessage)
        end
    end
    self.Window:_notifyChange(self, old, silent, source)
    return true
end
function Control:Set(value, silent, source)
    if self.Dead or self.Window.Dead then return self, false, "Control destroyed" end
    local ok, prepared = self:_prepare(value, source, false)
    if not ok then return self, false, prepared end
    local success, message = self:_apply(prepared, silent, source)
    return self, success, message
end
function Control:OnChanged(callback)
    local listener = {Connected = true, Callback = callback}
    function listener:Disconnect() self.Connected = false end
    self.Listeners[#self.Listeners + 1] = listener
    return listener
end
function Control:BindVisible(dependency, predicate)
    local function update()
        local visible
        if type(dependency) == "function" then visible = dependency(self.Window.Flags)
        else
            local value = self.Window.Flags[dependency]
            if predicate then visible = predicate(value, self.Window.Flags) else visible = value == true end
        end
        self:SetVisible(not not visible)
    end
    local connection = self.Window:On("Changed", update)
    self.Window.Connections[#self.Window.Connections + 1] = connection
    update()
    return self
end
function Control:BindDisabled(predicate)
    local function update() self:SetDisabled(not not predicate(self.Window.Flags)) end
    local connection = self.Window:On("Changed", update)
    self.Window.Connections[#self.Window.Connections + 1] = connection
    update()
    return self
end
function Control:Reset(silent) return self:Set(copy(self.Default), silent, "reset") end
function Control:Destroy()
    if self.Dead then return end
    self.Dead = true
    if self.Flag then self.Window.Controls[self.Flag] = nil self.Window.Flags[self.Flag] = nil end
    if self.Row then self.Row.Visible = false self.Row:Destroy() end
    if self.Channels then for _, channel in pairs(self.Channels) do channel:Destroy() end end
    self.Window:_emit("ControlRemoved", self)
end
function Window:Get(flag) return copy(self.Flags[flag]) end
function Window:Set(flag, value, silent)
    assert(self.Controls[flag], "Unknown flag: " .. tostring(flag))
    return self.Controls[flag]:Set(value, silent)
end
function Window:GetConfig()
    local flags = {}
    for flag, value in pairs(self.Flags) do
        local control = self.Controls[flag]
        if not control or control.Persist ~= false then flags[flag] = copy(value) end
    end
    return HttpService:JSONEncode({Version = 3, Flags = flags, UI = {Width = self.Width, Height = self.Height, Scale = self.Scale,
        Position = {X = self.Position.X, Y = self.Position.Y}, ToggleBind = self.ToggleBind,
        Blur = self.BlurEnabled, BlurPadding = self.BlurObject and copy(self.BlurObject.Padding) or nil, Resizable = self.Resizable ~= false}})
end
function Window:LoadConfig(data, silent)
    local ok, decoded = pcall(function() return type(data) == "string" and HttpService:JSONDecode(data) or data end)
    if not ok or type(decoded) ~= "table" then return false, "Invalid JSON config" end
    local flags = decoded.Flags or decoded
    if type(flags) ~= "table" then return false, "Invalid config flags" end
    if not self:_emit("BeforeConfigLoad", decoded) then return false, "Load cancelled" end
    local ui = decoded.UI
    if ui ~= nil then
        local validUI, message = pcall(function()
            assert(type(ui) == "table", "Invalid UI settings")
            for _, key in ipairs({"Width", "Height", "Scale"}) do
                local v = ui[key]
                if v ~= nil then assert(type(v) == "number" and v == v and math.abs(v) < math.huge and v > 0, "Invalid UI " .. key) end
            end
            if ui.Position then
                for _, key in ipairs({"X", "Y"}) do local v = ui.Position[key] assert(type(v) == "number" and v == v and math.abs(v) < math.huge, "Invalid position") end
            end
            for _, key in ipairs({"Blur", "Resizable"}) do if ui[key] ~= nil then assert(type(ui[key]) == "boolean", "Invalid UI " .. key) end end
            if ui.ToggleBind then Library:NormalizeKeybind(ui.ToggleBind) end
            if ui.BlurPadding then blurPadding(ui.BlurPadding) end
        end)
        if not validUI then return false, tostring(message) end
    end
    local plan = {}
    local valid, errorMessage = pcall(function()
        for flag, value in pairs(flags) do
            local control = self.Controls[flag]
            if control and control.Persist ~= false then
                local prepared, result = control:_prepare(value, "config", true)
                assert(prepared, result)
                plan[#plan + 1] = {Control = control, Value = result, Previous = control:Get()}
            end
        end
    end)
    if not valid then return false, tostring(errorMessage) end
    self.LoadingConfig = true
    local applied = {}
    for _, item in ipairs(plan) do
        local success, message = item.Control:_apply(item.Value, true, "config")
        if not success then
            for i = #applied, 1, -1 do applied[i].Control:_apply(applied[i].Previous, true, "rollback") end
            self.LoadingConfig = false
            self:_emit("ConfigError", message)
            return false, message
        end
        applied[#applied + 1] = item
    end
    self:Batch(function()
        for _, item in ipairs(plan) do self:_notifyChange(item.Control, item.Previous, silent, "config") end
    end)
    if ui then
        if ui.Width or ui.Height then self:SetSize(ui.Width or self.Width, ui.Height or self.Height) end
        if ui.Scale then self:SetScale(ui.Scale) end
        if ui.Position then self:SetPosition(ui.Position.X, ui.Position.Y) end
        if ui.ToggleBind then self:SetToggleKey(ui.ToggleBind) end
        if ui.Blur ~= nil then self:SetBlur(ui.Blur) end
        if ui.BlurPadding then self:SetBlurPadding(ui.BlurPadding) end
        if ui.Resizable ~= nil then self:SetResizable(ui.Resizable) end
    end
    self.LoadingConfig = false
    self:_emit("ConfigLoaded", decoded)
    return true
end
function Window:Reset(silent)
    self:Batch(function()
        for _, control in ipairs(self.AllControls) do if not control.Dead and control.Persist ~= false then control:Reset(silent) end end
    end)
    return self
end
function Window:EnableAutoSave(path, delay)
    local folder = self.ConfigStore and self.ConfigStore.Directory or ("Stereo/Game_" .. tostring(game.GameId or game.PlaceId or 0))
    local name = self.ConfigStore and self.ConfigStore.Selected or "autosave"
    self.AutoSave = {Path = path or (folder .. "/" .. tostring(name or "autosave") .. ".json"), Delay = delay or 0.5}
