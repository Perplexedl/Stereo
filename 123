end
function Window:DisableAutoSave() self.AutoSave = nil return self end
function Window:_scheduleSave()
    self.SaveGeneration = self.SaveGeneration + 1
    local generation = self.SaveGeneration
    task.delay(self.AutoSave.Delay, function()
        if not self.Dead and self.AutoSave and self.SaveGeneration == generation then
            local ok, message = self:SaveConfig(self.AutoSave.Path)
            self:_emit(ok and "ConfigSaved" or "ConfigError", message)
        end
    end)
end
function Window:SaveConfig(path)
    if type(writefile) ~= "function" then return false, "Executor has no writefile" end
    if not path and self.ConfigStore then return self.ConfigStore:Save(self.ConfigStore.Selected) end
    path = path or ("Stereo/Game_" .. tostring(game.GameId or game.PlaceId or 0) .. "/config.json")
    if type(makefolder) == "function" then
        local prefix = ""
        local folder = path:match("^(.*)/[^/]+$")
        if folder then
            for segment in folder:gmatch("[^/]+") do prefix = prefix == "" and segment or prefix .. "/" .. segment pcall(makefolder, prefix) end
        end
    end
    local ok, result = pcall(function() writefile(path, self:GetConfig()) return path end)
    return ok, result
end
