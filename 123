                item.Scale.Scale = scale
                local x = right and view.X - settings.Margin - item.Width * scale or settings.Margin
                local y = bottom and view.Y - cursor - height or cursor
                local rootPosition = gui.AbsolutePosition
                x, y = x - math.max(0, rootPosition.X), y - math.max(0, rootPosition.Y)
                if item.Fresh and shown then
