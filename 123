    local view = self:_viewport()
    local rootPosition = self.Gui.AbsolutePosition
    local left, top = rootPosition.X, rootPosition.Y
    local scale = math.min(self.EffectiveScale, (view.X - 8) / width, (view.Y - 8) / height)
