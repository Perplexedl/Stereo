    self:_closePopup(true)
    local previous = self.CurrentPage
    self.CurrentPage = page
    self:_applyPageLayout(page)
    local selectedTab = page.Tab
    local previousTab = self.SelectedTab
    self.SelectedTab = selectedTab
    for _, tab in ipairs(self.Tabs) do
        tab.SetActive(tab == selectedTab)
        tab.Subbar.Visible = tab == selectedTab
        for _, subpage in ipairs(tab.Pages) do
            if subpage.SetActive then subpage.SetActive(subpage == page) end
        end
    end
    selectedTab.LastPage = page
    self.Transition = self.Transition + 1
    local token = self.Transition
    for _, tab in ipairs(self.Tabs) do
        for _, other in ipairs(tab.Pages) do
            if other ~= previous and other ~= page then other.Container.Visible = false end
        end
    end
    local direction = 1
    if previous then
        if previousTab == selectedTab then direction = page.Index > previous.Index and 1 or -1
        else direction = selectedTab.Index > previousTab.Index and 1 or -1 end
    end
    page.Container.Visible = true
    page.Container.Interactable = true
    page.Container.Position = UDim2.fromScale(instant and 0 or direction, 0)
    if previous then
        previous.Container.Interactable = false
        if instant then previous.Container.Visible = false
        else tween(previous.Container, {Position = UDim2.fromScale(-direction, 0)}, 0.3, "Cubic") end
    end
    if not instant then tween(page.Container, {Position = UDim2.fromScale(0, 0)}, 0.3, "Cubic") end
