            Library.BindingCapture = nil Library.LastCapturedInput = type(input) ~= "string" and input or nil Library.CaptureTime = os.clock()
            control.Listening = false
            if bind ~= "Escape" then control:Set(bind == "Backspace" and "None" or bind, false, "input") end
            control.Paint()
        end
        return
    end
    if input == Library.LastCapturedInput or (Library.CaptureTime and os.clock() - Library.CaptureTime < 0.1) then return end
    if down and not processed and not self.Modal and not UserInputService:GetFocusedTextBox() and bind == self.ToggleBind and bind ~= "None" then self:Toggle() end
    if self.Modal then return end
    for _, control in ipairs(self.KeybindControls or {}) do
        if not control.Dead and not control.Disabled and not control.Listening and control.Value == bind and bind ~= "None" and not (down and (processed or UserInputService:GetFocusedTextBox())) then
            if down and not control.Held then
                control.Held = true
                if control.Mode == "Toggle" then control.Active = not control.Active elseif control.Mode == "Hold" then control.Active = true end
                call(control.OnPressed, input, control)
                call(control.OnTriggered, control.Mode == "Press" and true or control.Active, control)
            elseif not down and control.Held then
                control.Held = false
                if control.Mode == "Hold" then control.Active = false call(control.OnTriggered, false, control) end
                call(control.OnReleased, input, control)
            end
        end
    end
end
