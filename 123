local function environmentFunction(path)
    local environments = {_G}
    if type(getgenv) == "function" then
        local ok, result = pcall(getgenv)
        if ok and type(result) == "table" then table.insert(environments, 1, result) end
    end
    if type(getfenv) == "function" then
        local ok, result = pcall(getfenv, 0)
        if ok and type(result) == "table" then table.insert(environments, 1, result) end
    end
    for _, environment in ipairs(environments) do
        local ok, result = pcall(function()
            local current = environment
            for segment in path:gmatch("[^.]+") do
                if type(current) ~= "table" then return nil end
                current = current[segment]
            end
            return current
        end)
        if ok and type(result) == "function" then return result end
    end
    return nil
end
function Library:ReportEnvironment()
    local identify = identifyexecutor or getexecutorname or environmentFunction("identifyexecutor") or environmentFunction("getexecutorname")
    local report = {Executor = {Name = "unknown", Version = "unknown"}, UNC = {Status = "AvailabilityOnly", Available = 0, Total = 0, Missing = {}}, SUNC = {Status = "NotRun"}, LocalChecks = {}}
    if type(identify) == "function" then
        local ok, name, versionName = pcall(identify)
        if ok then report.Executor.Name = compactText(name) report.Executor.Version = compactText(versionName) end
    end
    if report.Executor.Version == "unknown" then
        local versionFunction = getexecutorversion or environmentFunction("getexecutorversion")
        if type(versionFunction) == "function" then
            local ok, versionName = pcall(versionFunction)
            if ok then report.Executor.Version = compactText(versionName) end
        end
    end
    local paths = {
        "getgenv", "getrenv", "getgc", "getinstances", "getnilinstances", "getscripts", "getrunningscripts",
        "cloneref", "compareinstances", "gethui", "identifyexecutor", "getexecutorname",
        "getconnections", "firesignal", "getcallbackvalue", "gethiddenproperty", "sethiddenproperty",
        "getrawmetatable", "setrawmetatable", "setreadonly", "isreadonly", "hookfunction", "hookmetamethod",
        "newcclosure", "checkcaller", "iscclosure", "islclosure", "isexecutorclosure", "loadstring",
        "readfile", "writefile", "isfile", "isfolder", "makefolder", "listfiles", "getcustomasset",
        "getthreadidentity", "setthreadidentity", "request", "http_request", "getscriptbytecode",
        "getscriptclosure", "getscriptchecksum", "debug.getconstants", "debug.getupvalues", "debug.getprotos",
        "crypt.base64encode", "crypt.base64decode", "crypt.base64.encode", "crypt.base64.decode"
    }
    for _, path in ipairs(paths) do
        report.UNC.Total = report.UNC.Total + 1
        if environmentFunction(path) then report.UNC.Available = report.UNC.Available + 1
        else report.UNC.Missing[#report.UNC.Missing + 1] = path end
    end
    local function check(name, callback)
        local ok, result = pcall(callback)
        report.LocalChecks[#report.LocalChecks + 1] = {Name = name, Passed = ok and result == true, Status = ok and result == true and "PASS" or "FAIL", Detail = not ok and tostring(result) or nil}
    end
    check("loadstring", function()
        local compile = loadstring or environmentFunction("loadstring")
        assert(type(compile) == "function", "missing")
        local compiled = assert(compile("return 19 + 23"))
        return compiled() == 42
    end)
    check("getgenv", function()
        local get = getgenv or environmentFunction("getgenv")
        return type(get) == "function" and type(get()) == "table"
    end)
    if environmentFunction("newcclosure") then
        check("newcclosure", function()
            local closure = environmentFunction("newcclosure")(function(a, b) return a + b end)
            return type(closure) == "function" and closure(19, 23) == 42
        end)
    end
    if environmentFunction("cloneref") then
        local object = Instance.new("Folder")
        check("cloneref", function()
            local reference = environmentFunction("cloneref")(object)
            return typeof(reference) == "Instance" and reference.ClassName == "Folder" and reference.Name == object.Name
        end)
        object:Destroy()
    end
    if environmentFunction("getthreadidentity") then
        check("getthreadidentity read", function() return type(environmentFunction("getthreadidentity")()) == "number" end)
    end
    local passed = 0
    for _, result in ipairs(report.LocalChecks) do if result.Passed then passed = passed + 1 end end
    report.PassedLocalChecks = passed
    self.EnvironmentReport = report
    diagnostic("Executor: " .. report.Executor.Name .. " | Version: " .. report.Executor.Version)
    diagnostic("UNC API availability: " .. report.UNC.Available .. "/" .. report.UNC.Total .. " (presence only, not an official UNC score)")
    if #report.UNC.Missing > 0 then diagnostic("Missing APIs: " .. table.concat(report.UNC.Missing, ", ")) end
    diagnostic("Safe local checks: " .. passed .. "/" .. #report.LocalChecks .. " passed")
    for _, result in ipairs(report.LocalChecks) do diagnostic(result.Name .. ": " .. result.Status) end
    diagnostic("SUNC: NOT RUN; no official suite executed and no certification claimed")
    return report
end
